{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "铭荼",
  "version": "0.1.0",
  "identifier": "cn.mingos.mingtea",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:agent && pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "铭荼",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "resources/ming-tea-agent.mjs": "ming-tea-agent.mjs"
    },
    "category": "Utility",
    "shortDescription": "Ming OS system agent assistant",
    "longDescription": "铭荼是一个可控、可审计的桌面 Agent 助手。",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 720,
          "height": 480
        },
        "appPosition": {
          "x": 180,
          "y": 160
        },
        "applicationFolderPosition": {
          "x": 540,
          "y": 160
        }
      }
    },
    "externalBin": [
      "binaries/ming-tea-hotkey"
    ]
  }
}
