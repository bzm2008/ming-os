<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDisplayName</key><string>铭荼</string>
<key>NSAppleEventsUsageDescription</key><string>铭荼需要自动化权限来执行你授权的桌面任务。</string>
<!-- 语音输入（本地 SenseVoice）需要麦克风；不声明的话 WKWebView 里 getUserMedia 会被直接拒绝 -->
<key>NSMicrophoneUsageDescription</key><string>铭荼用麦克风听你说话，语音在本机识别（本地 SenseVoice），音频不上传。</string>
<!-- 热键守护进程用 mingtea://summon 把应用拉起来；scheme 必须在这里注册，否则 open 找不到应用 -->
<key>CFBundleURLTypes</key>
<array>
  <dict>
    <key>CFBundleURLName</key><string>cn.mingos.mingtea</string>
    <key>CFBundleURLSchemes</key>
    <array><string>mingtea</string></array>
  </dict>
</array>
</dict></plist>
