# Build outputs (huge ISO files)
*.iso
output/*.iso
output/

# External Xiahai package injected by MING_XIAHAI_DEB_SOURCE at build time.
# The build validates its package metadata and SHA256; it is never committed.
/assets/vendor/xiahai-xiaoming/xiahai-xiaoming_0.0.2-beta_amd64.deb

# Trae IDE
.trae/

# Ventoy
ventoy-*.zip

# Wget logs
wget-log*

# Local build logs and one-off helper scripts
build-logs/
test-evidence/
*.log
*.exit
repackage_*.sh
repack_*.sh
resume-build.log
qemu_verify_*.sh
make_bootable_iso.sh
make-bootable.log

# Local migration/backups and Python caches
.rebrand-backup/
__pycache__/
**/__pycache__/
*.pyc

# Codex/desktop inspection artifacts and one-off local helpers
/scratch/
/.superpowers/
/_tmp_*
/rebrand_to_ming.py
/Calamares

# Agent 工具产物（只对本机/本次会话有意义，不入库）
/.playwright-mcp/
/platform/ming-tea/.codex/

# Local 铭荼 DSH runtime install; reproducible package metadata lives in assets.
/.ming-tea/
/platform/ming-tea/node_modules/
/platform/ming-tea/**/node_modules/
/platform/ming-tea/apps/desktop/dist/
/platform/ming-tea/apps/desktop/src-tauri/target/
/platform/ming-tea/apps/desktop/src-tauri/resources/
# Tauri v2 的 ACL schema 是 tauri-build 每次构建生成的（可复现），不入库
/platform/ming-tea/apps/desktop/src-tauri/gen/
# 热键守护进程的 cargo 产物（130MB+，可复现）
/platform/ming-tea/apps/hotkey-daemon/target/
/platform/ming-tea/scripts/.cache/
/platform/ming-tea/tsconfig.tsbuildinfo

# OS files
.DS_Store
Thumbs.db
*.swp

# Tauri externalBin 暂存目录（构建产物，由 pnpm build:hotkey 生成）
/platform/ming-tea/apps/desktop/src-tauri/binaries/
